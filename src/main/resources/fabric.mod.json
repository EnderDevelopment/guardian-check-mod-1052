{
  "schemaVersion": 1,
  "id": "playercheckmod",
  "version": "${version}",
  "name": "Player Check Mod",
  "description": "A Fabric mod for Minecraft 1.21.11 with /check and /uncheck commands featuring Guardian-style head animation",
  "authors": ["Michealifies"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.michealifies.playercheckmod.PlayerCheckMod"
    ]
  },
  "minecraft": {
    "*": {
      "version": "${minecraft_version}",
      "ordering": "NONE",
      "side": "BOTH"
    }
  },
  "depends": {
    "fabricloader": ">=0.15.7",
    "fabric-api": ">=0.96.7+1.21.11",
    "minecraft": "1.21.11"
  }
}